<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>电话和录音</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>拨号盘双卡线路按钮</string>
			<key>key</key>
			<string>captureDualSimDialerEnabled</string>
			<key>defaults</key>
			<string>com.axs.springtwelve</string>
			<key>default</key>
			<false/>
			<key>footerText</key>
			<string>仅显示系统报告的前两条可用线路；线路名称和可用性由系统决定。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>T9 联系人快速查找</string>
			<key>key</key>
			<string>captureT9DialerEnabled</string>
			<key>defaults</key>
			<string>com.axs.springtwelve</string>
			<key>default</key>
			<false/>
			<key>footerText</key>
			<string>启用后在电话拨号界面按数字前缀匹配联系人；不会主动请求授权，若系统限制访问则无法匹配。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>禁用电话 App 个人收藏标签</string>
			<key>key</key>
			<string>disablePhoneFavoritesTab</string>
			<key>defaults</key>
			<string>com.axs.springtwelve</string>
			<key>default</key>
			<false/>
			<key>footerText</key>
			<string>更改后请完全结束并重新打开电话 App。与录音列表替换同一标签同时开启时，隐藏优先。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>禁用电话 App 语音留言标签</string>
			<key>key</key>
			<string>disablePhoneVoicemailTab</string>
			<key>defaults</key>
			<string>com.axs.springtwelve</string>
			<key>default</key>
			<false/>
			<key>footerText</key>
			<string>更改后请完全结束并重新打开电话 App。与录音列表替换同一标签同时开启时，隐藏优先。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>蜂窝通话接通自动录音</string>
			<key>key</key>
			<string>callRecordingEnabled</string>
			<key>defaults</key>
			<string>com.axs.springtwelve</string>
			<key>default</key>
			<false/>
			<key>footerText</key>
			<string>默认关闭。接通后自动录音，挂断后生成一份 MP3，保存到 /var/mobile/Documents/CallRecordings。录音中显示红色提示，请先取得参与者同意。</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>显示通话录音列表入口</string>
