		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>录音列表替换语音留言标签</string>
			<key>key</key>
			<string>captureReplaceVoicemailTab</string>
			<key>defaults</key>
			<string>com.axs.springtwelve</string>
			<key>default</key>
			<false/>
