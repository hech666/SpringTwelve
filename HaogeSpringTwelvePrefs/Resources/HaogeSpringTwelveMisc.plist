			<string>ios27StatusBarEnabled</string>
			<key>defaults</key>
			<string>com.haoge.springtwelve</string>
			<key>default</key>
			<false/>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
